---
layout: base.njk
title: Post history
permalink: /posts/
---
<div class="panel posts">
  <a class="logo" href="/">forest of conifer trees</a>
  <div class="txt">
    <h2>Post history</h2>
    {% if collections.postsNewest.length %}
      <ul>
        {% for post in collections.postsNewest %}
          <li><a href="{{ post.url }}">{{ post.date | ymd }} {{ post.data.title }}</a></li>
        {% endfor %}
      </ul>
    {% else %}
      <p>Nothing yet</p>
    {% endif %}
  </div>
  <img class="post-img" src="/assets/video/celestia.jpg" alt="" aria-hidden="true">
</div>
