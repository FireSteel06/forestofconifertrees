---
layout: base.njk
title: Art in progress
permalink: /art/
---
{% if art | length %}
{% for a in art %}
<div class="panel art" style="--x:{{ a.x or '70%' }};--y:{{ a.y or '25%' }}">
  {% if loop.first %}<a class="logo" href="/">forest of conifer trees</a>{% endif %}
  <div class="txt{% if not loop.first %} t0{% endif %}"><h2>{{ a.code }}</h2><div>{{ a.title }}</div><div>{{ a.meta }}</div><span class="pr" style="--p:{{ a.progress }}"></span><div>{{ a.stage }}</div></div>
  {% if a.image %}<img class="ph" src="{{ a.image }}" alt="{{ a.title }}">{% else %}<div class="ctr">No scan yet</div>{% endif %}
</div>
{% endfor %}
{% else %}
<div class="panel art" style="--x:78%;--y:18%">
  <a class="logo" href="/">forest of conifer trees</a>
  <div class="txt"><h2>Art in progress</h2><p>Nothing yet.</p></div>
</div>
{% endif %}
<footer><a href="/">forest of conifer trees</a></footer>
