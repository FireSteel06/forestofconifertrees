---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{% if collections.postsNewest.length %}{{ collections.postsNewest[0].date | rfc3339 }}{% else %}{{ page.date | rfc3339 }}{% endif %}</updated>
  <author><name>{{ site.author }}</name></author>
  {% for post in collections.postsNewest %}{% if loop.index <= 20 %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | rfc3339 }}</updated>
    <summary>{{ post.data.excerpt }}</summary>
  </entry>
  {% endif %}{% endfor %}
</feed>